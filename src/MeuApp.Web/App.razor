<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MeuApp.Web.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="@typeof(MeuApp.Web.Components.Layout.MainLayout)">
            <h1>Página não encontrada</h1>
            <p>A página que você tentou acessar não existe.</p>
        </LayoutView>
    </NotFound>
</Router>