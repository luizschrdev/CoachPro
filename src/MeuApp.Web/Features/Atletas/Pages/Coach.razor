@page "/coach"

<PageTitle>Falar com coach</PageTitle>

<div class="student-page chat-page">
    <header class="chat-header">
        <div class="avatar">RC</div>
        <div>
            <h1>Rafael Costa</h1>
            <span class="coach-status"><span class="online-dot"></span>Online</span>
        </div>
    </header>

    <section class="panel-card chat-card">
        <div class="chat-scroll">
            <div class="message received">Coach, fiz o treino de peito hoje. Consegui aumentar 5kg no supino &#128170;</div>
            <span class="message-time">09:14</span>

            <div class="message sent">Ótimo, Lucas! Progresso excelente. Na próxima semana ajustamos o volume.</div>
            <span class="message-time right">09:22</span>

            <div class="message received">Posso substituir a banana pré-treino por maçã?</div>
            <span class="message-time">09:35</span>

            <div class="message sent">Pode sim! A maçã tem menos carboidrato, então adiciona 1 torrada integral também para manter energia.</div>
        </div>

        <div class="chat-input-row">
            <input type="text" placeholder="Mensagem para o coach..." />
            <button type="button" aria-label="Enviar mensagem">
                <i class="bi bi-send" aria-hidden="true"></i>
            </button>
        </div>
    </section>
</div>
