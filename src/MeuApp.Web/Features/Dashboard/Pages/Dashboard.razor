@page "/dashboard"
@page "/inicio"

<PageTitle>Início</PageTitle>

<div class="student-page dashboard-page">
    <header class="screen-header">
        <h1>Bom dia, Lucas <span aria-hidden="true">&#128075;</span></h1>
        <span class="soft-pill success">Semana 6/12</span>
    </header>

    <section class="hero-grid">
        <article class="panel-card focus-card accent-green">
            <span class="mini-label">Treino de hoje</span>
            <strong>Segunda — Peito + Tríceps</strong>
            <a class="outline-button" href="treino">Ver treino</a>
        </article>

        <article class="panel-card focus-card accent-blue">
            <span class="mini-label">Calorias de hoje</span>
            <strong>1.840 / 2.800 kcal</strong>
            <div class="progress-track">
                <span style="width: 66%" class="blue"></span>
            </div>
        </article>
    </section>

    <section class="panel-card summary-card">
        <h2>RESUMO DO DIA</h2>

        <div class="summary-grid">
            <div class="summary-stat green">
                <strong>3/4</strong>
                <span>Refeições</span>
            </div>
            <div class="summary-stat blue">
                <strong>2/2</strong>
                <span>Suplementos</span>
            </div>
            <div class="summary-stat purple">
                <strong>0/1</strong>
                <span>Cardio</span>
            </div>
            <div class="summary-stat amber">
                <strong>2L</strong>
                <span>Água</span>
            </div>
        </div>
    </section>

    <section class="panel-card coach-preview">
        <div class="avatar">RC</div>
        <div>
            <strong>Mensagem do seu coach</strong>
            <p>"Semana 6 concluída! Progresso excelente. Cardio ajustado."</p>
        </div>
        <a class="outline-button" href="coach">Responder</a>
    </section>
</div>
