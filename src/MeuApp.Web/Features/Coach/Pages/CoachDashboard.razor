@page "/coach-dashboard"

<PageTitle>Painel do coach</PageTitle>

<div class="coach-page coach-dashboard-page">
    <header class="screen-header">
        <h1>Painel do coach</h1>
        <span class="soft-pill success">12 atletas ativos</span>
    </header>

    <section class="coach-metrics">
        <article class="panel-card coach-metric">
            <span>Check-ins hoje</span>
            <strong>5</strong>
            <small>3 pendentes</small>
        </article>

        <article class="panel-card coach-metric">
            <span>Mensagens</span>
            <strong>8</strong>
            <small>2 sem resposta</small>
        </article>

        <article class="panel-card coach-metric">
            <span>Aderência média</span>
            <strong>86%</strong>
            <small>+4% na semana</small>
        </article>
    </section>

    <section class="panel-card coach-workbench">
        <div>
            <h2 class="section-title">ATLETAS EM FOCO</h2>
            <div class="coach-athlete-row">
                <div class="avatar">LM</div>
                <div>
                    <strong>Lucas Mendes</strong>
                    <span>Semana 6/12 · cardio ajustado</span>
                </div>
                <span class="status-badge success">Em dia</span>
            </div>

            <div class="coach-athlete-row">
                <div class="avatar">MA</div>
                <div>
                    <strong>Mariana Alves</strong>
                    <span>Check-in aguardando revisão</span>
                </div>
                <span class="status-badge warning">Pendente</span>
            </div>
        </div>

        <div>
            <h2 class="section-title">PRÓXIMAS AÇÕES</h2>
            <div class="coach-task-list">
                <div>
                    <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                    Revisar check-in do Lucas
                </div>
                <div>
                    <i class="bi bi-chat-dots" aria-hidden="true"></i>
                    Responder dúvidas de dieta
                </div>
                <div>
                    <i class="bi bi-activity" aria-hidden="true"></i>
                    Ajustar treino A da semana
                </div>
            </div>
        </div>
    </section>
</div>
