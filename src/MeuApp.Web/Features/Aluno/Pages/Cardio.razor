@page "/cardio"

<PageTitle>Cardio</PageTitle>

<div class="student-page cardio-page">
    <header class="screen-header">
        <h1>Cardio desta semana</h1>
    </header>

    <section class="panel-card list-panel">
        <article class="list-row">
            <div class="icon-box icon-mint">
                <i class="bi bi-person-walking" aria-hidden="true"></i>
            </div>
            <div class="row-text">
                <strong>Caminhada em jejum</strong>
                <span>30 min · Seg, Qua, Sex · 06h30</span>
            </div>
            <span class="status-badge success">✓ Feito</span>
        </article>

        <article class="list-row">
            <div class="icon-box icon-lilac">
                <i class="bi bi-bicycle" aria-hidden="true"></i>
            </div>
            <div class="row-text">
                <strong>Bike ergométrica</strong>
                <span>20 min · Sábado · Pós-treino</span>
            </div>
            <span class="status-badge warning">Sábado</span>
        </article>

        <article class="list-row">
            <div class="icon-box icon-peach">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>
            </div>
            <div class="row-text">
                <strong>HIIT na esteira</strong>
                <span>15 min · Terça · Sprint Interval</span>
            </div>
            <span class="status-badge success">✓ Feito</span>
        </article>
    </section>

    <section class="panel-card">
        <h2 class="section-title">SEMANA ATUAL</h2>
        <div class="adherence-row">
            <span>Cardios realizados</span>
            <strong>2 / 3</strong>
            <div class="progress-track">
                <span class="bar-purple" style="width: 67%"></span>
            </div>
        </div>
    </section>
</div>
